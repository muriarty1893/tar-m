# Google Apps Script web app URL that writes form submissions to Google Sheets.
# See docs/apps-script.md. Server-only: never expose these to the browser.
APPS_SCRIPT_URL=
# Must match the SECRET script property in the Apps Script project.
APPS_SCRIPT_SECRET=

# Public base URL of the site (used for sitemap and social share images).
NEXT_PUBLIC_SITE_URL=https://bereket-ai.vercel.app
