# Google Apps Script web app URL that writes form submissions to Google Sheets.
# See docs/apps-script.md. Server-only: never expose these to the browser.
APPS_SCRIPT_URL=
# Must match the SECRET script property in the Apps Script project.
APPS_SCRIPT_SECRET=

# Public base URL of the site (used for sitemap and social share images).
NEXT_PUBLIC_SITE_URL=https://bereket-ai.vercel.app

# Accounts, Pazar and Mesajlar (docs/accounts-and-market.md). `vercel env pull .env.local` fills these
# from the connected Clerk, Neon and Vercel Blob integrations.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BLOB_READ_WRITE_TOKEN=
# Admins (/yonetim: news and reports): Clerk user ids and/or verified e-mail addresses, comma separated.
ADMIN_USER_IDS=
ADMIN_EMAILS=
