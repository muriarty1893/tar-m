# Public base URL of the site (used for sitemap and social share images).
NEXT_PUBLIC_SITE_URL=https://bereket-ai.vercel.app

# Accounts, Pazar and Mesajlar (docs/accounts-and-market.md). `vercel env pull .env.local` fills these
# from the connected Clerk, Neon and Vercel Blob integrations.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BLOB_READ_WRITE_TOKEN=
# Admins (/yonetim: news and reports): Clerk user ids and/or verified e-mail addresses, comma separated.
ADMIN_USER_IDS=
ADMIN_EMAILS=

# Vercel Cron: /api/cron/haberler accepts only "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# Google AdSense (optional). Publisher id "ca-pub-…" turns on the consent banner, ads.txt and the
# AdSense script; the display ad unit's data-ad-slot number fills the site's ad strips.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
